{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src/ts",
    "outDir": "src/js",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/ts"]
}
